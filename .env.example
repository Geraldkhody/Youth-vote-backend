# Copy this file to .env and fill in real values. .env is git-ignored.

# Flask settings
FLASK_ENV=development
SECRET_KEY=change-me

# Deployed frontend origin allowed to call this API (CORS)
FRONTEND_ORIGIN=https://hsccawards.vercel.app, http://localhost:5173/

# The deployed frontend is on a different domain than this API (cross-site),
# so the admin session cookie needs SameSite=None + Secure in production.
# Leave these as-is for local dev (plain HTTP, same-origin via the Vite proxy).
# SESSION_COOKIE_SAMESITE=None
# SESSION_COOKIE_SECURE=True

# Database connection (XAMPP MariaDB locally, MySQL in production)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=youth_vote

# Secret segment of the Hubtel USSD webhook URLs, e.g.
# /api/hubtel/<HUBTEL_PATH_TOKEN>/interaction. Must be at least 24
# characters (generate a long random string) or the Hubtel routes won't
# register at all.
HUBTEL_PATH_TOKEN=

# Hubtel's transaction status-check API. Never commit real values.
HUBTEL_COLLECTION_ACCOUNT=
HUBTEL_API_ID=
HUBTEL_API_SECRET=
HUBTEL_STATUS_BASE_URL=https://api-txnstatus.hubtel.com

# The final callback Hubtel asks us to send once a transaction is fulfilled.
HUBTEL_FINAL_CALLBACK_URL=https://gs-callback.hubtel.com:9055/callback
# Off by default -- must be explicitly set to true to actually send it.
HUBTEL_CALLBACK_ENABLED=false

# "live" talks to the real Hubtel APIs. "fake" (dev/local only -- refuses
# to start if APP_ENV=production) makes the status check always report
# "paid" with the exact expected amount, and only logs the final callback.
HUBTEL_MODE=live
APP_ENV=development

# Trust the X-Forwarded-For header for the client IP on Hubtel requests?
# Only turn this on if we're actually behind a reverse proxy that sets it
# -- otherwise a caller could fake their IP and dodge the allowlist below.
HUBTEL_TRUST_PROXY_HEADERS=false

# Optional allowlist for the Service Fulfilment URL, comma-separated IPs.
# Empty (default) means no restriction -- every IP is accepted.
# Hubtel's documented fulfilment IPs are 52.50.116.54, 18.202.122.131 and
# 52.31.15.68. Enable this only after confirming from the Hubtel log
# (source_ip column / GET /api/admin/hubtel-log) that real requests
# actually show those addresses: behind a proxy the visible address may
# differ, and a wrong setting here would block real payments.
HUBTEL_FULFILMENT_ALLOWED_IPS=
