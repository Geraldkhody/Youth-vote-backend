# Copy this file to .env and fill in real values. .env is git-ignored.

# Flask settings
FLASK_ENV=development
SECRET_KEY=change-me

# Deployed frontend origin allowed to call this API (CORS)
FRONTEND_ORIGIN=https://hsccawards.vercel.app, http://localhost:5173/

# The deployed frontend is on a different domain than this API (cross-site),
# so the admin session cookie needs SameSite=None + Secure in production.
# Leave these as-is for local dev (plain HTTP, same-origin via the Vite proxy).
# SESSION_COOKIE_SAMESITE=None
# SESSION_COOKIE_SECURE=True

# Database connection (XAMPP MariaDB locally, MySQL in production)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=youth_vote
